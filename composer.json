{
  "name": "ez-php/support",
  "version": "2.3.8",
  "description": "General-purpose utility classes for the ez-php ecosystem — Range, WeightedRandom, TimeProbability, DailyQuota",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["support", "utilities", "range", "weighted-random", "time-probability", "daily-quota", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/support",
  "support": {
    "issues": "https://github.com/ez-php/support/issues",
    "source": "https://github.com/ez-php/support"
  },
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\Support\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
